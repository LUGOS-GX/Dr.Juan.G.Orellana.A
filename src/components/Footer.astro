---
import { doctor, horarios, desarrollador, contacto } from '../data/site';
import Iconos from './Iconos.astro';

const anio = new Date().getFullYear();
---

<footer class="bg-black pb-28 lg:pb-0">
  <div class="mx-auto max-w-[1240px] px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Identidad -->
      <div class="lg:col-span-5">
        <span class="cruz block h-[18px] w-[22px] text-white/40" aria-hidden="true"></span>
        <p class="titular mt-5 text-2xl text-white sm:text-3xl">{doctor.nombre}</p>
        <p class="mt-2 text-white/60">{doctor.especialidadSecundaria} · {doctor.especialidad}</p>
        <p class="dato mt-4 text-sm leading-relaxed text-white/45">
          CM: {doctor.cm}<br />
          MPPS: {doctor.mpps}
        </p>
      </div>

      <!-- Horarios -->
      <div class="lg:col-span-4">
        <p class="etiqueta text-white/40">Horario de atención</p>
        <dl class="mt-5 space-y-2">
          {
            horarios.map((h) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-2">
                <dt class="text-sm text-white/85">{h.dias}</dt>
                <dd class="dato text-sm text-white/55">{h.detalle}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Contacto rápido -->
      <div class="lg:col-span-3">
        <p class="etiqueta text-white/40">Contacto</p>
        <ul class="mt-5 space-y-3">
          <li>
            <a href={contacto.telefonoLink} class="dato text-sm text-white/85 transition-colors hover:text-white">
              {contacto.telefonoVisible}
            </a>
          </li>
          <li>
            <a href={contacto.emailLink} class="dato text-sm break-all text-white/85 transition-colors hover:text-white">
              {contacto.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="etiqueta text-white/35">© {anio} {doctor.nombre}</p>
      <a
        href={desarrollador.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-sm text-white/50 transition-colors hover:text-white"
      >
        <span>Hecho por {desarrollador.nombre}</span>
        <Iconos nombre="linkedin" clase="w-4 h-4 opacity-60 group-hover:opacity-100" />
      </a>
    </div>
  </div>
</footer>
