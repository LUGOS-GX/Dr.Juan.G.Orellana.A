---
import { preguntas } from '../data/faq';
---

<section id="preguntas" class="bg-white">
  <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
    <p class="etiqueta text-verde-500" data-revelar>Preguntas frecuentes</p>
    <h2
      class="titular mt-4 max-w-2xl text-[clamp(2rem,6vw,3.5rem)] text-verde-700"
      data-revelar
      style="--retardo:80ms"
    >
      Dudas antes<br />de llamar
    </h2>

    <dl class="mt-10 grid gap-px overflow-hidden rounded-sm bg-verde-100 sm:mt-12 lg:grid-cols-2">
      {
        preguntas.map((p, i) => (
          <div class="bg-white p-8 sm:p-10" data-revelar style={`--retardo:${i * 70}ms`}>
            <dt class="titular text-xl text-verde-700 sm:text-2xl">{p.pregunta}</dt>
            <dd class="mt-3 text-[0.95rem] leading-relaxed text-verde-800/70">{p.respuesta}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
