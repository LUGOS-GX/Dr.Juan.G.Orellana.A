---
import '../styles/global.css';
import { doctor, contacto, cobertura } from '../data/site';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;

const esquema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: doctor.nombre,
  medicalSpecialty: 'Epidemiology',
  description: descripcion,
  telephone: contacto.telefonoVisible,
  email: contacto.email,
  areaServed: cobertura.map((ciudad) => ({
    '@type': 'City',
    name: `${ciudad}, Anzoátegui, Venezuela`
  })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lechería',
    addressRegion: 'Anzoátegui',
    addressCountry: 'VE'
  },
  availableService: [
    { '@type': 'MedicalTherapy', name: 'Atención médica a domicilio' },
    { '@type': 'MedicalTherapy', name: 'Videoconsulta médica' }
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '00:00',
      closes: '23:59'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '07:00',
      closes: '22:00'
    }
  ]
};
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0a192f" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:image" content="/img/dr-juan-orellana.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500&display=swap"
    />
    <link rel="preload" as="image" href="/img/dr-juan-orellana.webp" fetchpriority="high" />
    <link rel="preconnect" href="https://www.google.com" />

    <script type="application/ld+json" set:html={JSON.stringify(esquema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
