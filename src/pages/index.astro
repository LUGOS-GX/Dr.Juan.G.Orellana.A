---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import BarraLlamada from '../components/BarraLlamada.astro';
import Preguntas from '../components/Preguntas.astro';
import { preguntas } from '../data/faq';

const esquemaExtra = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: preguntas.map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.respuesta }
    }))
  }
];
---

<Layout
  titulo="Médico a domicilio en Lechería y Anzoátegui | Dr. Juan G. Orellana A."
  descripcion="Médico general y epidemiólogo a domicilio en Lechería, Barcelona, Puerto La Cruz y Guanta. Consultas en casa, récipes y constancias el mismo día. Lunes a viernes 24 horas. Llame al +58 414 823 7097."
  ruta="/"
  esquemaExtra={esquemaExtra}
>
  <Header />
  <main>
    <Hero />
    <Servicios />
    <Preguntas />
    <Contacto />
  </main>
  <Footer />
  <BarraLlamada />
</Layout>

<script>
  // Estado de disponibilidad en hora de Venezuela
  const punto = document.getElementById('pulso-estado');
  const texto = document.getElementById('texto-estado');

  function estadoActual() {
    const partes = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Caracas',
      weekday: 'short',
      hour: 'numeric',
      minute: 'numeric',
      hour12: false
    }).formatToParts(new Date());

    const obtener = (tipo: string) => partes.find((p) => p.type === tipo)?.value ?? '';
    const dia = obtener('weekday');
    const hora = Number(obtener('hour')) % 24;
    const minuto = Number(obtener('minute'));
    const reloj = `${String(hora).padStart(2, '0')}:${String(minuto).padStart(2, '0')}`;

    if (dia === 'Sun') {
      return { abierto: false, mensaje: `Domingo · Solo emergencias · ${reloj}` };
    }

    if (dia === 'Sat') {
      const dentro = hora >= 7 && hora < 22;
      return dentro
        ? { abierto: true, mensaje: `Atendiendo ahora · Sábado ${reloj}` }
        : { abierto: false, mensaje: `Fuera de horario · Emergencias por WhatsApp` };
    }

    return { abierto: true, mensaje: `Atendiendo ahora · Lunes a viernes 24 h · ${reloj}` };
  }

  function actualizar() {
    if (!punto || !texto) return;
    const { abierto, mensaje } = estadoActual();
    punto.dataset.estado = abierto ? 'abierto' : 'cerrado';
    texto.textContent = mensaje;
  }

  actualizar();
  setInterval(actualizar, 30000);

  // Revelado al hacer scroll
  const elementos = document.querySelectorAll('[data-revelar]');
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducido || !('IntersectionObserver' in window)) {
    elementos.forEach((el) => el.classList.add('visible'));
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add('visible');
            observador.unobserve(entrada.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
    );

    elementos.forEach((el) => observador.observe(el));
  }
</script>
